<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Imagen de fondo -->
    <ImageView
        android:id="@+id/fondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Filtro verde transparente -->
    <View
        android:id="@+id/filtro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80D5F6D5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Imagen Biopochito principal -->
    <ImageView
        android:id="@+id/biopochitoImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="32dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/biopochito"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintHeight_min="150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnIniciar"
        app:layout_constraintVertical_bias="0.3"/>

    <!-- Imagen Biopochito alternativa (oculta inicialmente) -->
    <ImageView
        android:id="@+id/biopochitoImage2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="32dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/biopochito2"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.35"
        app:layout_constraintHeight_min="150dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnIniciar"
        app:layout_constraintVertical_bias="0.3"/>

    <!-- Mensaje 1 -->
    <TextView
        android:id="@+id/msg1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="¡Hola! soy Biopochito \n y te doy la bienvenida a la App"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:background="@drawable/cloud_background"
        android:gravity="center"
        app:layout_constraintWidth_percent="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/biopochitoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"/>

    <!-- Mensaje 2 -->
    <TextView
        android:id="@+id/msg2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Aquí te queremos enseñar sobre la importancia del cuidado y preservación del medio ambiente"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:background="@drawable/cloud_background"
        android:gravity="center"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintWidth_percent="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/biopochitoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"/>

    <!-- Mensaje 3 -->
    <TextView
        android:id="@+id/msg3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Y para ello te mostraremos imágenes en realidad aumentada a través de la cámara de tu celular"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:background="@drawable/cloud_background"
        android:gravity="center"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintWidth_percent="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/biopochitoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"/>

    <!-- Mensaje 4 -->
    <TextView
        android:id="@+id/msg4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Así que da clic en el botón para que inicies con este aprendizaje"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:background="@drawable/cloud_background"
        android:gravity="center"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintWidth_percent="0.55"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/biopochitoImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"/>

    <!-- Botón Iniciar -->
    <Button
        android:id="@+id/btnIniciar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iniciar"
        android:textStyle="bold"
        android:textSize="24sp"
        android:background="@drawable/round_btn"
        android:paddingHorizontal="40dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@+id/biopochitoImage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.85"/>

</androidx.constraintlayout.widget.ConstraintLayout>